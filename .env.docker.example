# ═══════════════════════════════════════════════════════════════
# شهریار — پیکربندی اجرای Docker (فقط روی سرور)
# ═══════════════════════════════════════════════════════════════
# روی سرور کپی کنید:  cp .env.docker.example .env.docker
# ⚠️ این فایل را هرگز commit نکنید (در .gitignore هست) —
#    و وارد Docker Image هم نمی‌شود؛ فقط در زمان اجرا تزریق می‌شود.
# ═══════════════════════════════════════════════════════════════

# ─── شبکه ───
# پورت میزبان که اپ روی آن سرو می‌شود (DirectAdmin به همین پورت
# پراکسی می‌کند). 80 و 443 اشغال‌اند؛ 3100 انتخاب امنی است.
APP_PORT=3100

# فقط loopback (پیش‌فرض امن — دسترسی فقط از خود سرور/پراکسی).
# اگر می‌خواهید مستقیم از اینترنت با IP:PORT باز شود: 0.0.0.0
APP_BIND=127.0.0.1

# ─── امنیت ───
# ⛔ حیاتی: کلید امضای JWT — روی سرور با این دستور بسازید:
#    openssl rand -hex 32
# و خروجی‌اش را جای CHANGE_ME بگذارید.
# نکته: پس از تغییر این کلید، نشست‌های فعال باطل می‌شوند
# (کاربران یک‌بار دوباره وارد می‌شوند) — داده‌ها دست‌نخورده می‌مانند.
JWT_SECRET=CHANGE_ME__RUN_openssl_rand_hex_32

# ⛔ حیاتی: کلید رمزنگاری AES-256-GCM اعتبارنامه‌ی پنل پیامک (ملی‌پیامک).
# همان دستور:  openssl rand -hex 32
# نکته ۱: این کلید باید بین ری‌استارت‌ها «ثابت» بماند — اگر عوض شود،
#    رمز ذخیره‌شده‌ی پنل پیامک قابل رمزگشایی نیست و باید دوباره وارد شود.
# نکته ۲: کلید در ایمیج/گیت نیست؛ فقط در زمان اجرا از همین فایل تزریق
#    می‌شود (بدون آن، ذخیره‌ی تنظیمات پیامک و ثبت‌نام با کد پیامکی کار نمی‌کند).
SMS_ENC_KEY=CHANGE_ME__RUN_openssl_rand_hex_32

# ─── منطقه زمانی ───
TZ=Asia/Tehran

# ─── ⛔ هرگز در production فعال نکنید ───
# OTP_DEV_CODE فقط برای تست خودکار در محیط توسعه است؛ اگر مقدار
# بگیرد، ورود دو مرحله‌ای با «کد ثابت» قابل عبور است = حفره امنیتی.
# در سرور واقعی این متغیر را اصلاً تعریف نکنید.
# OTP_DEV_CODE=12345

# ─── Seed اولیه (فقط برای «نصب تازه» — اگر دیتابیس موجود را
#     از سرور قبلی کپی کرده‌اید، این بخش را خالی بگذارید) ───
# اجرا:  docker compose run --rm seed
SEED_ADMIN_USERNAME=hasansdq
SEED_ADMIN_NAME=حسن صادقی
# ⛔ پس از اتمام seed، این مقدار را از فایل حذف یا خالی کنید
SEED_ADMIN_PASSWORD=CHANGE_ME__STRONG_ADMIN_PASSWORD
