# ═══════════════════════════════════════════════════════════════
# شهریار — نمونه‌ی متغیرهای محیطی
# این فایل را به «.env» کپی کنید:  cp .env.example .env
# ═══════════════════════════════════════════════════════════════

# دیتابیس SQLite — مسیر نسبی به پوشه‌ی prisma/ (الگوی استاندارد Prisma)
# در زمان اجرا، برنامه مسیر را هوشمندانه نسبت به ریشه‌ی پروژه حل می‌کند
# و حتی بدون این فایل هم db/custom.db پیدا می‌شود.
DATABASE_URL=file:../db/custom.db
JWT_SECRET=change-me-to-a-64-char-random-hex
